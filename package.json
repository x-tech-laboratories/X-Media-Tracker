{
  "name": "x-media-tracker",
  "version": "0.2.0",
  "private": true,
  "description": "Movies and TV shows to watch, watching and watched, with ratings, episodes and collections, kept on every device and synced through your own server",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "X_MEDIA_TRACKER_CONFIG=${X_MEDIA_TRACKER_CONFIG:-config.example.json} X_MEDIA_TRACKER_PASSWORD_HASH_FILE=${X_MEDIA_TRACKER_PASSWORD_HASH_FILE:-password.hash} node --watch src/server/main.ts",
    "dev:web": "vite",
    "dev": "X_MEDIA_TRACKER_USER_DATA=${X_MEDIA_TRACKER_USER_DATA:-dev-data/desktop} electron-vite dev",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && electron-vite build",
    "build:android": "tsc -b && vite build -c vite.android.config.ts && cap sync android",
    "start": "NODE_ENV=production node src/server/main.ts",
    "hash-password": "node src/server/hash_password.ts",
    "start:desktop": "electron-vite preview",
    "typecheck": "tsc -b",
    "db:generate": "for config in src/shared/*/drizzle.config.ts src/shared/*/*/drizzle.config.ts; do drizzle-kit generate --config \"$config\" && x-libs-bundle-migrations \"$(dirname \"$config\")/migrations\" || exit 1; done",
    "test": "vitest run",
    "lint": "oxlint",
    "icons": "x-libs-icons"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@modelcontextprotocol/server": "^2.4.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@x-tech-laboratories/halon": "^0.16.0",
    "@x-tech-laboratories/x-libs": "^0.38.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "1.0.0-rc.5",
    "electron": "^43.0.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
